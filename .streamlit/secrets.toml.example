# Modèle pour la configuration de la base de données persistante (Postgres).
#
# 1. Copie ce fichier en `secrets.toml` (même dossier) — ce nom exact est
#    celui que Streamlit lit automatiquement au démarrage.
# 2. Remplace la valeur ci-dessous par ta vraie chaîne de connexion (voir
#    README.md, section "Base de données persistante (PostgreSQL)").
# 3. NE JAMAIS committer `secrets.toml` (il est dans .gitignore) — seul ce
#    fichier .example, sans vraie valeur, est versionné dans le dépôt.
#
# Si cette clé n'est pas définie (fichier absent, ou ligne commentée),
# l'application se rabat automatiquement sur une base SQLite locale
# (fichier documents.db) — pratique pour développer sans rien configurer.

DATABASE_URL = "postgresql+psycopg2://postgres:TON_MOT_DE_PASSE@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
