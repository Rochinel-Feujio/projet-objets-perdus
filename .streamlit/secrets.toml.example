# Modèle pour la configuration de la base de données persistante (Postgres).
#
# 1. Copie ce fichier en `secrets.toml` (même dossier) — ce nom exact est
#    celui que Streamlit lit automatiquement au démarrage.
# 2. Remplace la valeur ci-dessous par ta vraie chaîne de connexion (voir
#    README.md, section "Base de données persistante (PostgreSQL)").
# 3. NE JAMAIS committer `secrets.toml` (il est dans .gitignore) — seul ce
#    fichier .example, sans vraie valeur, est versionné dans le dépôt.
#
# Si cette clé n'est pas définie (fichier absent, ou ligne commentée),
# l'application se rabat automatiquement sur une base SQLite locale
# (fichier documents.db) — pratique pour développer sans rien configurer.

DATABASE_URL = "postgresql+psycopg2://postgres.xxxxxxxxxxxx:TON_MOT_DE_PASSE@aws-0-xxxxx.pooler.supabase.co:6543/postgres"
# ⚠️ Utilise bien la chaîne du "Transaction pooler" (bouton "Connect" dans le
# tableau de bord Supabase), pas la "Direct connection" (db.xxxx.supabase.co)
# — celle-ci est en IPv6 uniquement depuis 2024, et Streamlit Cloud n'y a pas accès.

# --- Notifications par email (optionnel) -----------------------------------
# Si ces clés sont absentes, les notifications sont simplement désactivées
# (l'application continue de fonctionner normalement). Voir README.md,
# section "Notifications par email", pour la marche à suivre avec Gmail
# (mot de passe d'application, pas ton vrai mot de passe Gmail).

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "465"
SMTP_USER = "ton.adresse@gmail.com"
SMTP_PASSWORD = "mot-de-passe-application-16-caracteres"
# SMTP_FROM = "ton.adresse@gmail.com"  # optionnel, reprend SMTP_USER par défaut
NOTIFY_EMAIL = "ton.adresse@gmail.com"

# --- IA de vision en complément de l'OCR (optionnel, gratuit) --------------
# Si cette clé est absente, l'application continue de fonctionner
# uniquement avec l'OCR local (Tesseract), exactement comme avant. Voir
# README.md, section "IA de vision (optionnel)", pour la marche à suivre :
# clé gratuite (palier "Experiment") sur https://console.mistral.ai —
# aucune carte bancaire requise, juste un numéro de téléphone à vérifier.

MISTRAL_API_KEY = "TA_CLE_API_MISTRAL_GRATUITE"
# MISTRAL_MODEL = "mistral-small-latest"  # optionnel, c'est déjà la valeur par défaut
